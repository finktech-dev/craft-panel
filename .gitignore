# Python virtual environments and caches
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
pytest_temp/
.pytest-tmp/
*.log

# Every clone starts with an empty local server. Never version a real server,
# players, worlds, mods or mod settings.
server/*
!server/.gitkeep
**/.archive-unpack/

# Databases and binary state
*.db
*.db-shm
*.db-wal
*.mv.db

# Backups and archives
backups/
client_pack/*.zip
*.zip

# Heavy or host-specific tooling
tools/*
!tools/.gitkeep
!tools/java/
tools/java/*
!tools/java/.gitkeep

# Build artifacts and profiles
node_modules/
build/
*.sparkprofile
*.bak

# Environment files and panel runtime state (secrets, per-host configuration)
.env
.env.local
.env.*
!.env.example
web_panel/.totp_secret
web_panel/.totp_secret.tmp
web_panel/.playit_agent_secret
web_panel/.playit_agent_secret.tmp
web_panel/.panel_secrets.json
web_panel/.panel_secrets.tmp
web_panel/.scheduled_tasks.json
web_panel/.discord_config.json
web_panel/.luckperms_config.json
web_panel/.custom_villagers.json
web_panel/.guide_book.json
web_panel/.player_crashes.json
web_panel/.server_connection.json
web_panel/.waypoints.json
web_panel/.worldedit_state.json
web_panel/.launch_settings.json
web_panel/config/presets/luckperms/current-server-ranks.json
