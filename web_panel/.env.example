# Copiá este archivo como .env junto al panel y reemplazá solo lo que necesites.
# Nunca subas .env ni URLs de webhooks: contienen secretos.
MINECRAFT_PROJECT_ROOT=/ruta/a/tu/servidor-minecraft
# If omitted, the panel discovers the project root from its own location.
MINECRAFT_DISCORD_SERVER_NAME=Mi servidor de Minecraft
MINECRAFT_DISCORD_SERVER_SOFTWARE_LABEL=Minecraft 1.21.1
MINECRAFT_DISCORD_WORLD_NAME=world
# El nombre de prueba no representa a un jugador real.
MINECRAFT_DISCORD_TEST_PLAYER_NAME=Jugador de prueba
# Usá una URL con {player_name}; dejala vacía para no incluir avatares.
MINECRAFT_DISCORD_PLAYER_AVATAR_URL_TEMPLATE=https://mc-heads.net/avatar/{player_name}/100.png
# Public status-banner title. Keep this generic or define your own server name.
MINECRAFT_BANNER_TITLE=My Minecraft server
# Optional local client configuration sync. Leave empty on dedicated servers.
# MINECRAFT_CLIENT_CONFIG_DIRECTORY=/path/to/minecraft/config
MINECRAFT_CLIENT_PACK_FILENAME=modpack.zip
# Directorios adicionales a incluir en el zip de mods para los clientes (ej. ["resourcepacks"], ["pointblank"])
# MINECRAFT_CLIENT_PACK_EXTRA_DIRECTORIES=["resourcepacks"]
# Configurá el webhook desde Administración > Discord o como variable local no versionada.
# MINECRAFT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
